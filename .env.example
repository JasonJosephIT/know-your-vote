# Know Your Vote — environment variables.
#
# NAMES ONLY. Never commit real values: .gitignore line 34 is `.env*`, and a
# secret that reaches a git history or a chat transcript must be rotated, not
# deleted. (See the toollayer AGENT_BRIEF §5 — three keys were already burned
# that way once.)
#
#   cp .env.example .env.local   # then fill in locally
#
# For the DEPLOYED app these live in Vercel → Settings → Environment
# Variables, not in any file. Anything without a NEXT_PUBLIC_ prefix is
# server-only and must never gain one — that prefix ships the value to the
# browser.

# --- Web app: Supabase ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — enables voting-info storage and the news cron.
SUPABASE_SERVICE_ROLE_KEY=

# --- Web app: features ----------------------------------------------------
# The NAME must match exactly: a variable the code doesn't read by this exact
# spelling is silently ignored. The one exception: Vercel production stores
# the service-role key as SUPABASE and the Resend key as RESEND, and
# src/lib/server-keys.ts reads each whenever SUPABASE_SERVICE_ROLE_KEY or
# RESEND_API_KEY, respectively, is unset or empty. Only the app (src/) falls
# back: local scripts read SUPABASE_SERVICE_ROLE_KEY alone, so .env.local
# needs that name (README "Environment variables";
# docs/general-election/reminders-e2e-runbook.md).
#
# Server-only. Google Maps Platform key for street addresses (since
# 2026-10-14): Places API (New) suggests addresses as the voter types and
# Geocoding API matches one typed without picking; only the resulting point
# goes on to the US Census Bureau. Enable both APIs on the key and restrict it
# to them. Without a key there is no address field, only the district picker.
GOOGLE_MAPS_API_KEY=
# Set ADDRESS_LOOKUP_OFF to any value to remove the address field even with a
# key (both address routes refuse, /privacy says nothing typed leaves the
# site); redeploy after changing either, since /privacy is static.
ADDRESS_LOOKUP_OFF=
# Server-only. Opt-in transactional email (polling place, deadlines).
RESEND_API_KEY=
# A sender on the Resend-verified domain, e.g. Know Your Vote <info@knowyour.vote>
EMAIL_FROM=
# Server-only. The Resend segment the /civics "Stay more informed" signup adds
# contacts to, with a `county` contact property (create both in Resend first).
# Unset: the page offers no signup form.
RESEND_UPDATES_SEGMENT_ID=
# Server-only. Shared secret the cron routes check before running.
CRON_SECRET=
# Server-only. The founder's own secret for /api/cron/send-correction, kept
# apart from CRON_SECRET so a scheduled caller can never mail the whole list.
# Unset = corrections are off. See reminders-e2e-runbook.md, "Sending a correction".
CORRECTION_SECRET=
# Comma-separated allowlist for the admin console.
ADMIN_EMAILS=
# Any non-empty value pauses outbound reminder sends without a code change --
# including the string `false`. To resume, remove the variable. On Vercel an
# env change reaches only new deployments, so redeploy after either.
NOTIFICATIONS_PAUSED=
# Renders the campaign-contact block, and only when set to exactly `true`.
# Held until the first real R2 refresher run is reviewed.
SHOW_CANDIDATE_CONTACT=

# --- Web app: optional ----------------------------------------------------
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# --- Admin console integrations (optional) --------------------------------
# Server-only, read by the admin Site page. Each panel names the exact var it
# is missing rather than going blank, so leaving these unset is a supported
# state, not a broken one.
#
# Deployments panel. VERCEL_TEAM_ID only when the project sits in a team.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Errors panel. SENTRY_URL only for self-hosted Sentry (default sentry.io).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=

# --- CAP pipeline (Python; toollayer/runtime, run locally) ----------------
# Postgres URL for the cap_tool_wrapper role — S1 only, never the web app.
SUPABASE_DB_URL=
# Postgres URL for the SELECT-only cap_readonly role (runtime/orchestration.py).
CAP_READONLY_DB_URL=
# The CAP agent runtime's model credential (runtime/cap_runtime/session.py;
# it also accepts ANTHROPIC_AUTH_TOKEN). NOT a web-app key: the app stopped
# reading it when the quiz was removed on 2026-09-25
# (docs/general-election/quiz-clipped-2026-09-25.md), and nothing under src/
# or scripts/ reads it. Never needed on Vercel.
ANTHROPIC_API_KEY=
FEC_API_KEY=

# TypeSafe System One (Jev) — issue tagging for swept news articles (C13) and
# the candidate-site ingest. Local scripts only: no route, cron or page reads
# it, so Vercel does not need it. Never exposed to the client. The real value
# goes in .env.local, which is gitignored; this file only ever holds empty keys.
TYPESAFE_API_KEY=

# Optional: T12 SMS dispatch degrades to `not_configured` until these are set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_OWNER_PHONE=
TWILIO_ENV=
# Set by the launcher per process, not by hand: identity binds at spawn
# (ADR-R1) and the dispatch token is minted by S3 at the human gate.
# CAP_AGENT_ID=
# CAP_LOG_SINK=
# CAP_DISPATCH_TOKEN=
