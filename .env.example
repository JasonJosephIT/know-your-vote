# Know Your Vote — environment variables.
#
# NAMES ONLY. Never commit real values: .gitignore line 34 is `.env*`, and a
# secret that reaches a git history or a chat transcript must be rotated, not
# deleted. (See the toollayer AGENT_BRIEF §5 — three keys were already burned
# that way once.)
#
#   cp .env.example .env.local   # then fill in locally
#
# For the DEPLOYED app these live in Vercel → Settings → Environment
# Variables, not in any file. Anything without a NEXT_PUBLIC_ prefix is
# server-only and must never gain one — that prefix ships the value to the
# browser.

# --- Web app: Supabase ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — enables voting-info storage and the news cron.
SUPABASE_SERVICE_ROLE_KEY=

# --- Web app: features ----------------------------------------------------
# Server-only. Enables the Find My Candidates quiz.
ANTHROPIC_API_KEY=
# Server-only. Enables address completion in the location field; without it the
# field takes a ZIP and the district picker still works.
#
# Pelias (https://pelias.io). WHERE IT RUNS IS THE PRIVACY DECISION, and it is
# made here rather than in code -- the API is identical either way:
#   * an instance you host  -> no third party ever sees a voter's address
#   * https://api.geocode.earth -> hosted Pelias; a geocoding company sees it,
#     needs PELIAS_API_KEY, and bills per plan
# The privacy page reads this host and describes whichever one is set, so it
# stays true without anyone remembering to edit the prose.
PELIAS_BASE_URL=
# Only for hosted Pelias (Geocode Earth authenticates by query parameter). A
# self-hosted instance normally needs nothing here.
PELIAS_API_KEY=
# Server-only. Opt-in transactional email (polling place, deadlines).
RESEND_API_KEY=
EMAIL_FROM=
# Server-only. Shared secret the cron routes check before running.
CRON_SECRET=
# Comma-separated allowlist for the admin console.
ADMIN_EMAILS=
# Any non-empty value pauses outbound reminder sends without redeploying --
# including the string `false`. To resume, remove the variable.
NOTIFICATIONS_PAUSED=
# Renders the campaign-contact block, and only when set to exactly `true`.
# Held until the first real R2 refresher run is reviewed.
SHOW_CANDIDATE_CONTACT=

# --- Web app: optional ----------------------------------------------------
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# --- Admin console integrations (optional) --------------------------------
# Server-only, read by the admin Site page. Each panel names the exact var it
# is missing rather than going blank, so leaving these unset is a supported
# state, not a broken one.
#
# Deployments panel. VERCEL_TEAM_ID only when the project sits in a team.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Errors panel. SENTRY_URL only for self-hosted Sentry (default sentry.io).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=

# --- CAP pipeline (Python; toollayer/runtime, run locally) ----------------
# Postgres URL for the cap_tool_wrapper role — S1 only, never the web app.
SUPABASE_DB_URL=
FEC_API_KEY=

# TypeSafe System One (Jev) — issue tagging for swept news articles (C13).
# Server-side only, never exposed to the client. The real value goes in
# .env.local, which is gitignored; this file only ever holds empty keys.
TYPESAFE_API_KEY=

# Optional: T12 SMS dispatch degrades to `not_configured` until these are set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_OWNER_PHONE=
TWILIO_ENV=
# Set by the launcher per process, not by hand: identity binds at spawn
# (ADR-R1) and the dispatch token is minted by S3 at the human gate.
# CAP_AGENT_ID=
# CAP_LOG_SINK=
# CAP_DISPATCH_TOKEN=
