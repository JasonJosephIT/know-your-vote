# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the names-only template is meant to be committed (README links it).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local
.DS_Store
__pycache__/
*.pyc

# --- reconciliation 2026-07-26 ---
# Agent scaffolding and crawl caches
.claude/
.claude-crawl/

# Generated ops output. RunReports are deliberately TRACKED: they are the
# R1-R4 symmetric-scrutiny audit trail (PRD §10 mitigation) and the evidence
# the candidate-news PRD cites. Only the regenerated ops digest is ignored.
Civic Awareness (Know Your Vote)/CAP_Ops_Digest_*.html

# This script
/reconcile-git.sh

# --- ballots by ZIP, 2026 general ---
# The derived files under docs/general-election/ballots/ ARE tracked: they are
# the ZIP → district → contest crosswalk the app reads from. Only the bulky
# upstream source is ignored — re-fetch it from flsenate.gov when §4.2 of
# docs/general-election/ballots-handoff.md needs it.
docs/general-election/ballots/EOGPCRP2026_block_assignment.txt
# The raw DoE candidate export carries addresses, phones and emails. Never commit it.
docs/general-election/ballots/doe_*.tsv
