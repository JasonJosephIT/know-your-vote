{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/refresh-news",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/news-sweep",
      "schedule": "0 11 * * *"
    }
  ]
}
